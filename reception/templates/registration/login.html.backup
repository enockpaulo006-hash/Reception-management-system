
{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Sign in - {{ CLINIC_NAME }}</title>

    <link rel="stylesheet" href="{% static 'css/app.css' %}?v=2">

    <style>
        body.auth-page {
            display: grid;
            place-items: center;
            min-width: 0;
            min-height: 100vh;
            margin: 0;
            padding: 20px 14px;
            box-sizing: border-box;
        }

        .auth-card {
            display: block;
            width: 100%;
            max-width: 400px;
            min-width: 0;
            margin: auto;
            padding: 30px;
            box-sizing: border-box;
            background: #ffffff;
            border: 1px solid #dfe7f2;
            border-radius: 16px;
            box-shadow: 0 12px 30px rgba(27, 57, 97, 0.09);
        }

        .login-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 110px;
            margin: 0 auto 20px;
            overflow: hidden;
        }

        .login-logo img {
            display: block !important;
            width: 110px !important;
            height: 110px !important;
            max-width: 110px !important;
            max-height: 110px !important;
            object-fit: contain !important;
            flex: 0 0 110px;
        }

        .auth-card h1 {
            margin: 0;
            font-size: 24px;
            text-align: center;
            overflow-wrap: anywhere;
        }

        .auth-card p {
            margin: 8px 0 24px;
            color: #6f819d;
            text-align: center;
        }

        .auth-card label {
            display: block;
            margin: 16px 0 6px;
        }

        .auth-card input {
            display: block;
            width: 100%;
            box-sizing: border-box;
        }

        .auth-card button {
            display: block;
            width: 100%;
            margin-top: 24px;
        }

        .auth-card .message {
            overflow-wrap: anywhere;
        }

        @media (max-width: 480px) {
            .auth-card {
                padding: 24px 20px;
            }

            .login-logo,
            .login-logo img {
                height: 90px;
            }

            .login-logo img {
                width: 90px !important;
                max-width: 90px !important;
                max-height: 90px !important;
                flex-basis: 90px;
            }
        }
    </style>
</head>

<body class="auth-page">

    <form
        class="auth-card"
        method="post"
        oncontextmenu="return false;"
    >
        {% csrf_token %}

        <div class="login-logo">
            <img
                src="{% static 'images/st-pius-logo.png' %}"
                alt="St. Pius Dispensary logo"
                width="110"
                height="110"
                style="width:110px !important;height:110px !important;max-width:110px !important;max-height:110px !important;object-fit:contain !important;"
            >
        </div>

        <h1>{{ CLINIC_NAME }}</h1>

        <p>Sign in to the clinic reception workspace.</p>

        {% if form.non_field_errors %}
            <div class="message error">
                {{ form.non_field_errors }}
            </div>
        {% endif %}

        {% if messages %}
            {% for message in messages %}
                <div class="message {{ message.tags }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endif %}

        <label for="{{ form.username.id_for_label }}">
            Username
        </label>
        {{ form.username }}

        <label for="{{ form.password.id_for_label }}">
            Password
        </label>
        {{ form.password }}

        <button type="submit">Sign in</button>
    </form>

</body>
</html>
